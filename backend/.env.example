# Copia este archivo como .env y rellena los valores. NUNCA subas el .env a GitHub.

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Modelo de la IA. Consulta los nombres vigentes en https://docs.claude.com
ANTHROPIC_MODEL=claude-haiku-5-5

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Único email con acceso a la web
ALLOWED_EMAIL=

# URL del frontend (Vercel). Puedes poner varias separadas por comas.
FRONTEND_ORIGIN=http://localhost:3000

PORT=10000

# Búsquedas web como máximo por pregunta en Radiopaedia, IAEA y EFRS (cada una cuesta ~1 céntimo).
# Pon 0 para desactivar la consulta online y que la IA sea casi gratis.
WEB_MAX_SEARCHES=3
