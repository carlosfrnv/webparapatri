# Copia este archivo como .env y rellena los valores. NUNCA subas el .env a GitHub.

# ---------- IA gratuita ----------
# Google Gemini: aistudio.google.com → Get API key (gratis, sin tarjeta).
GEMINI_API_KEY=
# Groq: console.groq.com → API Keys (gratis, sin tarjeta). Se usa cuando Gemini agota su cupo.
GROQ_API_KEY=
# Orden en que se prueban los modelos. Si uno agota su cupo gratuito, se pasa al siguiente.
AI_CHAIN=gemini:gemini-flash-latest,gemini:gemini-flash-lite-latest,groq:openai/gpt-oss-120b
# Opcional y de pago: con esta clave, Claude Haiku entra solo como último recurso cuando las IA gratuitas
# agotan su cupo. Si quieres otro orden, añade "anthropic:<modelo>" a AI_CHAIN.
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# (Opcional) Email(s) con acceso, separados por comas; el primero, el de Patri. Vacío = cualquier usuario creado en Supabase.
ALLOWED_EMAIL=

# URL del frontend (Vercel). Puedes poner varias separadas por comas.
FRONTEND_ORIGIN=http://localhost:3000

PORT=10000

# Consulta online a Radiopaedia, IAEA y EFRS (solo con Gemini o Claude; Groq no busca en internet).
# Pon 0 para desactivarla del todo.
WEB_MAX_SEARCHES=3

# (Opcional) Claves de los recordatorios en el móvil/iPad. Si las dejas vacías, el servidor las crea solo
# la primera vez y las guarda en Supabase. Si prefieres ponerlas tú: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Hora de Portugal a la que llegan los recordatorios del día (exámenes, entregas, flashcards).
REMINDER_HOUR=9
