# Copia este archivo como .env y rellena los valores. NUNCA subas el .env a GitHub.

# ---------- IA gratuita ----------
# Google Gemini: aistudio.google.com → Get API key (gratis, sin tarjeta).
GEMINI_API_KEY=
# Groq: console.groq.com → API Keys (gratis, sin tarjeta). Se usa cuando Gemini agota su cupo.
GROQ_API_KEY=
# Orden en que se prueban los modelos. Si uno agota su cupo gratuito, se pasa al siguiente.
AI_CHAIN=gemini:gemini-flash-latest,gemini:gemini-flash-lite-latest,groq:openai/gpt-oss-120b
# Opcional y de pago: para usar Claude añade "anthropic:claude-haiku-5-5" a AI_CHAIN y pon aquí la clave.
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# (Opcional) Email(s) con acceso, separados por comas; el primero, el de Patri. Vacío = cualquier usuario creado en Supabase.
ALLOWED_EMAIL=

# URL del frontend (Vercel). Puedes poner varias separadas por comas.
FRONTEND_ORIGIN=http://localhost:3000

PORT=10000

# Consulta online a Radiopaedia, IAEA y EFRS (solo con Gemini o Claude; Groq no busca en internet).
# Pon 0 para desactivarla del todo.
WEB_MAX_SEARCHES=3
