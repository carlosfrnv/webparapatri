# Copia este ficheiro para .env e preenche os valores. NUNCA subas o .env ao GitHub.

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Modelo da IA. Consulta os nomes vigentes em https://docs.claude.com
ANTHROPIC_MODEL=claude-opus-5-5

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Único email com acesso à web
ALLOWED_EMAIL=

# URL do frontend (Vercel). Podes pôr várias separadas por vírgulas.
FRONTEND_ORIGIN=http://localhost:3000

PORT=10000
